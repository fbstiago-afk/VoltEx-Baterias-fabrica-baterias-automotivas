{
  "name": "VoltEx Industrial Dark",
  "dataColors": [
    "#FF8C00",
    "#C9D3DB",
    "#7A8B99",
    "#4E5D6A",
    "#FFB547",
    "#2FBF71",
    "#E5484D",
    "#A3B1BD"
  ],
  "foreground": "#FFFFFF",
  "foregroundNeutralSecondary": "#7A8B99",
  "foregroundNeutralTertiary": "#4E5D6A",
  "background": "#232B32",
  "backgroundLight": "#2C363F",
  "backgroundNeutral": "#3A4651",
  "tableAccent": "#FF8C00",
  "good": "#2FBF71",
  "neutral": "#FF8C00",
  "bad": "#E5484D",
  "maximum": "#FF8C00",
  "center": "#7A8B99",
  "minimum": "#2C363F",
  "hyperlink": "#FF8C00",
  "visitedHyperlink": "#FFB547",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 10,
      "color": "#7A8B99"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#7A8B99"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 24,
      "color": "#FFFFFF"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#FFFFFF"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "visualTooltip": [
          {
            "background": {
              "solid": {
                "color": "#2C363F"
              }
            },
            "titleFontColor": {
              "solid": {
                "color": "#7A8B99"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#7A8B99"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#232B32"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#232B32"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "filter": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": {
              "solid": {
                "color": "#232B32"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "border": true,
            "borderColor": {
              "solid": {
                "color": "#3A4651"
              }
            }
          }
        ]
      }
    }
  }
}