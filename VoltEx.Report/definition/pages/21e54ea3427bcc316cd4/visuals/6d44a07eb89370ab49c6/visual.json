                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"config\": {\n    \"view\": {\n      \"stroke\": null\n    },\n    \"background\": \"transparent\",\n    \"font\": \"Segoe UI\"\n  },\n  \"title\": {\n    \"text\": \"Linha do tempo de paradas · horas paradas por semana, planta e linha\",\n    \"color\": \"#7A8B99\",\n    \"anchor\": \"start\",\n    \"fontSize\": 12,\n    \"fontWeight\": \"normal\",\n    \"font\": \"Segoe UI Semibold\",\n    \"offset\": 10\n  },\n  \"width\": \"container\",\n  \"height\": \"container\",\n  \"transform\": [\n    {\n      \"calculate\": \"datum[''Planta''] + ''  ·  '' + datum[''Linha'']\",\n      \"as\": \"Celula\"\n    }\n  ],\n  \"mark\": {\n    \"type\": \"rect\",\n    \"tooltip\": true\n  },\n  \"encoding\": {\n    \"x\": {\n      \"field\": \"Semana\",\n      \"type\": \"temporal\",\n      \"timeUnit\": \"yearweek\",\n      \"axis\": {\n        \"labelColor\": \"#7A8B99\",\n        \"labelFont\": \"Segoe UI\",\n        \"labelFontSize\": 10,\n        \"domain\": false,\n        \"ticks\": false,\n        \"title\": null,\n        \"format\": \"%b/%y\",\n        \"labelAngle\": 0,\n        \"tickCount\": 10\n      }\n    },\n    \"y\": {\n      \"field\": \"Celula\",\n      \"type\": \"nominal\",\n      \"title\": null,\n      \"axis\": {\n        \"labelColor\": \"#FFFFFF\",\n        \"labelFont\": \"Segoe UI\",\n        \"labelFontSize\": 10,\n        \"domain\": false,\n        \"ticks\": false,\n        \"title\": null,\n        \"labelLimit\": 200\n      }\n    },\n    \"color\": {\n      \"field\": \"Horas\",\n      \"type\": \"quantitative\",\n      \"scale\": {\n        \"type\": \"threshold\",\n        \"domain\": [\n          7,\n          10\n        ],\n        \"range\": [\n          \"#3A4651\",\n          \"#FF8C00\",\n          \"#E5484D\"\n        ]\n      },\n      \"legend\": {\n        \"title\": null,\n        \"labelColor\": \"#7A8B99\",\n        \"orient\": \"top\",\n        \"direction\": \"horizontal\",\n        \"titleFontWeight\": \"normal\",\n        \"symbolType\": \"square\"\n      }\n    },\n    \"tooltip\": [\n      {\n        \"field\": \"Planta\"\n      },\n      {\n        \"field\": \"Linha\"\n      },\n      {\n        \"field\": \"Semana\",\n        \"type\": \"temporal\",\n        \"format\": \"%d/%m/%Y\",\n        \"title\": \"Semana de\"\n      },\n      {\n        \"field\": \"Horas\",\n        \"format\": \".1f\",\n        \"title\": \"Horas paradas\"\n      },\n      {\n        \"field\": \"Falhas\",\n        \"format\": \",.0f\"\n      }\n    ]\n  }\n}'"
