                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v5.json\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"config\": {\n    \"view\": {\n      \"stroke\": null\n    },\n    \"background\": \"transparent\",\n    \"font\": \"Segoe UI\"\n  },\n  \"title\": {\n    \"text\": \"Refugo por SKU vs. meta de 1,5% · rótulo = custo do refugo\",\n    \"color\": \"#7A8B99\",\n    \"anchor\": \"start\",\n    \"fontSize\": 12,\n    \"fontWeight\": \"normal\",\n    \"font\": \"Segoe UI Semibold\",\n    \"offset\": 10\n  },\n  \"width\": \"container\",\n  \"height\": \"container\",\n  \"encoding\": {\n    \"y\": {\n      \"field\": \"Produto\",\n      \"type\": \"nominal\",\n      \"sort\": {\n        \"field\": \"Custo\",\n        \"order\": \"descending\"\n      },\n      \"axis\": {\n        \"labelColor\": \"#FFFFFF\",\n        \"labelFont\": \"Segoe UI\",\n        \"labelFontSize\": 11,\n        \"domain\": false,\n        \"ticks\": false,\n        \"title\": null,\n        \"labelLimit\": 160\n      }\n    }\n  },\n  \"layer\": [\n    {\n      \"mark\": {\n        \"type\": \"rect\",\n        \"color\": \"#2FBF71\",\n        \"opacity\": 0.14\n      },\n      \"encoding\": {\n        \"x\": {\n          \"datum\": 0\n        },\n        \"x2\": {\n          \"datum\": 0.015\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"rect\",\n        \"color\": \"#FF8C00\",\n        \"opacity\": 0.1\n      },\n      \"encoding\": {\n        \"x\": {\n          \"datum\": 0.015\n        },\n        \"x2\": {\n          \"datum\": 0.03\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"bar\",\n        \"height\": 8,\n        \"cornerRadiusEnd\": 4\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"Scrap\",\n          \"type\": \"quantitative\",\n          \"scale\": {\n            \"domain\": [\n              0,\n              0.035\n            ]\n          },\n          \"axis\": {\n            \"labelColor\": \"#7A8B99\",\n            \"labelFont\": \"Segoe UI\",\n            \"labelFontSize\": 10,\n            \"domain\": false,\n            \"ticks\": false,\n            \"title\": null,\n            \"format\": \".1%\",\n            \"grid\": false\n          }\n        },\n        \"color\": {\n          \"condition\": {\n            \"test\": \"datum[''Scrap''] < 0.015\",\n            \"value\": \"#2FBF71\"\n          },\n          \"value\": \"#FF8C00\"\n        },\n        \"tooltip\": [\n          {\n            \"field\": \"Produto\"\n          },\n          {\n            \"field\": \"Scrap\",\n            \"format\": \".2%\",\n            \"title\": \"Refugo\"\n          },\n          {\n            \"field\": \"CustoTxt\",\n            \"title\": \"Custo do refugo\"\n          }\n        ]\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"tick\",\n        \"color\": \"#FFFFFF\",\n        \"thickness\": 2,\n        \"size\": 22\n      },\n      \"encoding\": {\n        \"x\": {\n          \"datum\": 0.015\n        }\n      }\n    },\n    {\n      \"mark\": {\n        \"type\": \"text\",\n        \"align\": \"left\",\n        \"dx\": 8,\n        \"color\": \"#7A8B99\",\n        \"fontSize\": 10\n      },\n      \"encoding\": {\n        \"x\": {\n          \"field\": \"Scrap\",\n          \"type\": \"quantitative\"\n        },\n        \"text\": {\n          \"field\": \"CustoTxt\"\n        }\n      }\n    }\n  ],\n  \"transform\": [\n    {\n      \"calculate\": \"''R$ '' + format(datum[''Custo''], '',.0f'')\",\n      \"as\": \"CustoTxt\"\n    }\n  ]\n}'"
