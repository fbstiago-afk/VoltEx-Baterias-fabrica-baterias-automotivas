	partition Fato_Producao = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook ( File.Contents ( CaminhoBase ), null, true ),
				    Planilha = Fonte{[Item = "Fato_Producao", Kind = "Sheet"]}[Data],
				    Cabecalho = Table.PromoteHeaders ( Planilha, [PromoteAllScalars = true] ),
				    Tipos = Table.TransformColumnTypes ( Cabecalho, {
				        {"ID_Producao", Int64.Type},
				        {"Data_Producao", type date},
				        {"ID_Produto", Int64.Type},
				        {"ID_Fabrica", Int64.Type},
				        {"Horas_Turno_Programado", Int64.Type},
				        {"Horas_Parada_Maquina", type number},
				        {"Qtd_Falhas_Equipamento", Int64.Type},
				        {"Qtd_Produzida", Int64.Type},
				        {"Qtd_Refugo", Int64.Type}
				    } ),
				    Resultado = Table.AddColumn ( Tipos, "Regime_Turno", each
				        if [Horas_Turno_Programado] <= 8 then "1 turno · 8 h"
				        else if [Horas_Turno_Programado] <= 16 then "2 turnos · 16 h"
				        else "3 turnos · 24 h", type text )
				in
				    Resultado

	annotation PBI_ResultType = Table

