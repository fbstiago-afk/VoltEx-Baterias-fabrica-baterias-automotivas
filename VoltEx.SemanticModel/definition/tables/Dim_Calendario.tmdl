	column Janela_Inverno
		dataType: string
		lineageTag: 70e3a7e1-6503-5a3b-96eb-87c26c7228ad
		summarizeBy: none
		sourceColumn: Janela_Inverno

		annotation SummarizationSetBy = Automatic

	partition Dim_Calendario = m
		mode: import
		source =
				let
				    // Ajuste o intervalo se a base crescer
				    DataMin = #date ( 2022, 1, 1 ),
				    DataMax = #date ( 2025, 12, 31 ),
				    Lista = List.Dates ( DataMin, Duration.Days ( DataMax - DataMin ) + 1, #duration ( 1, 0, 0, 0 ) ),
				    Tabela = Table.FromList ( Lista, Splitter.SplitByNothing (), {"Data"} ),
				    Tipada = Table.TransformColumnTypes ( Tabela, {{"Data", type date}} ),
				    Ano = Table.AddColumn ( Tipada, "Ano", each Date.Year ( [Data] ), Int64.Type ),
				    MesNum = Table.AddColumn ( Ano, "Mes_Num", each Date.Month ( [Data] ), Int64.Type ),
				    Mes = Table.AddColumn ( MesNum, "Mes", each Text.Proper ( Date.ToText ( [Data], "MMM", "pt-BR" ) ), type text ),
				    AnoMes = Table.AddColumn ( Mes, "AnoMes", each [Ano] * 100 + [Mes_Num], Int64.Type ),
				    AnoMesTxt = Table.AddColumn ( AnoMes, "Ano_Mes", each Date.ToText ( [Data], "MMM/yy", "pt-BR" ), type text ),
				    MesIni = Table.AddColumn ( AnoMesTxt, "Mes_Inicio", each Date.StartOfMonth ( [Data] ), type date ),
				    SemIni = Table.AddColumn ( MesIni, "Semana_Inicio", each Date.StartOfWeek ( [Data], Day.Monday ), type date ),
				    Tri = Table.AddColumn ( SemIni, "Trimestre", each "T" & Text.From ( Date.QuarterOfYear ( [Data] ) ), type text ),
				    Resultado = Table.AddColumn ( Tri, "Janela_Inverno", each if List.Contains ( {5, 6, 7, 8}, [Mes_Num] ) then "Mai–Ago" else "Demais meses", type text )
				in
				    Resultado

	annotation PBI_ResultType = Table

