	measure 'KPI OEE HTML' = "<div style='display:flex;font-family:Segoe UI,Arial,sans-serif;padding-top:2px'>" & "<div class='vx-k' style='flex:1;min-width:0;padding:4px 14px 0 0;margin-right:14px;border-right:1px solid #3A4651;'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap'>OEE</div><div class='vx-v' style='font-size:21px;line-height:28px;font-weight:600;color:#FFFFFF;margin-top:4px;white-space:nowrap'>" & IF ( ISBLANK ( [OEE] ), "—", FORMAT ( [OEE], "0.0%" ) ) & "</div><div style='font-size:10.5px;color:#7A8B99;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "<span class='vx-dot' style='display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:" & [Cor OEE] & "'></span>" & "Meta > 85%" & "</div></div>" & "<div class='vx-k' style='flex:1;min-width:0;padding:4px 14px 0 0;margin-right:14px;border-right:1px solid #3A4651;'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap'>Disponibilidade</div><div class='vx-v' style='font-size:21px;line-height:28px;font-weight:600;color:#FFFFFF;margin-top:4px;white-space:nowrap'>" & IF ( ISBLANK ( [Disponibilidade] ), "—", FORMAT ( [Disponibilidade], "0.0%" ) ) & "</div><div style='font-size:10.5px;color:#7A8B99;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "<span class='vx-dot' style='display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:" & "#7A8B99" & "'></span>" & FORMAT ( [Horas Parada], "#,0" ) & " h paradas" & "</div></div>" & "<div class='vx-k' style='flex:1;min-width:0;padding:4px 14px 0 0;margin-right:14px;border-right:1px solid #3A4651;'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap'>Performance</div><div class='vx-v' style='font-size:21px;line-height:28px;font-weight:600;color:#F