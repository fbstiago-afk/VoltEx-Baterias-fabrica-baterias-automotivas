	measure 'Trilha Filtros HTML' =
			VAR _Periodo = IF ( ISFILTERED ( Dim_Calendario ), "<span class='vx-pop' style='display:inline-block;margin:0 6px 6px 0;padding:4px 10px;border:1px solid #FF8C00;border-radius:999px;color:#FFFFFF;font-size:11px;font-weight:600'><span style='color:#7A8B99;font-weight:400'>Período</span> " & FORMAT ( MIN ( Dim_Calendario[Data] ), "dd/mm/yy" ) & " – " & FORMAT ( MAX ( Dim_Calendario[Data] ), "dd/mm/yy" ) & "</span>" )
			VAR _Planta = IF ( ISFILTERED ( Dim_Fabrica[Planta_Curta] ), "<span class='vx-pop' style='display:inline-block;margin:0 6px 6px 0;padding:4px 10px;border:1px solid #FF8C00;border-radius:999px;color:#FFFFFF;font-size:11px;font-weight:600'><span style='color:#7A8B99;font-weight:400'>Planta</span> " & CONCATENATEX ( VALUES ( Dim_Fabrica[Planta_Curta] ), Dim_Fabrica[Planta_Curta], ", " ) & "</span>" )
			VAR _Linha = IF ( ISFILTERED ( Dim_Produto[Categoria] ), "<span class='vx-pop' style='display:inline-block;margin:0 6px 6px 0;padding:4px 10px;border:1px solid #FF8C00;border-radius:999px;color:#FFFFFF;font-size:11px;font-weight:600'><span style='color:#7A8B99;font-weight:400'>Linha</span> " & CONCATENATEX ( VALUES ( Dim_Produto[Categoria] ), Dim_Produto[Categoria], ", " ) & "</span>" )
			VAR _Produto = IF ( ISFILTERED ( Dim_Produto[Nome_Curto] ), "<span class='vx-pop' style='display:inline-block;margin:0 6px 6px 0;padding:4px 10px;border:1px solid #FF8C00;border-radius:999px;color:#FFFFFF;font-size:11px;font-weight:600'><span style='color:#7A8B99;font-weight:400'>Produto</span> " & CONCATENATEX ( VALUES ( Dim_Produto[Nome_Curto] ), Dim_Produto[Nome_Curto], ", " ) & "</span>" )
			VAR _Cliente = IF ( ISFILTERED ( Dim_Cliente[Nome_Cliente] ), "<span class='vx-pop' style='display:inline-block;margin:0 6px 6px 0;padding:4px 10px;border:1px solid #FF8C00;border-radius:999px;color:#FFFFFF;font-size:11px;font-weight:600'><span style='color:#7A8B99;font-weight:400'>Cliente</span> " & CONCATENATEX ( VALUES ( Dim_Cliente[Nome_Cliente] ), Dim_Cliente[Nome_Cliente], ", " ) & "</span>" )
			VAR _Todos = _Periodo & _Planta & _Linha & _Produto & _Cliente
			RETURN
			    "<div style='font-family:Segoe UI,Arial,sans-serif;padding-top:2px'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap;margin-bottom:8px'>Filtros ativos</div>" & IF ( _Todos = "", "<span style='color:#7A8B99;font-size:11px'>Nenhum filtro · visão consolidada da operação</span>", _Todos ) & "</div>"
		displayFolder: 91 HTML
		lineageTag: b43b581c-9b93-5b1b-917e-f85e9493be69

	measure 'Insights Executivo HTML' =
			VAR _ShFatPes = CALCULATE ( [Share Faturamento], Dim_Produto[Categoria] = "Linha Pesada" )
			VAR _ShUnPes = CALCULATE ( [Share Unidades], Dim_Produto[Categoria] = "Linha Pesada" )
			VAR _LbPes = CALCULATE ( [Lucro Bruto por Unidade], Dim_Produto[Categoria] = "Linha Pesada" )
			VAR _LbLeve = CALCULATE ( [Lucro Bruto por Unidade], Dim_Produto[Categoria] = "Linha Leve" )
			VAR _Pior = TOPN ( 1, FILTER ( VALUES ( Dim_Produto[Nome_Curto] ), NOT ISBLANK ( [Taxa Logistica Reversa] ) ), [Taxa Logistica Reversa], ASC )
			VAR _PiorNome = MAXX ( _Pior, Dim_Produto[Nome_Curto] )
			VAR _PiorTaxa = MAXX ( _Pior, [Taxa Logistica Reversa] )
			VAR _MtbfGap = DIVIDE ( [Meta MTBF], [MTBF (h)] )
			VAR _T1 = "<div class='vx-i' style='display:flex;gap:12px;margin-bottom:10px'><div style='font-size:11px;font-weight:700;color:#FF8C00;min-width:18px;padding-top:2px'>01</div><div><div style='font-size:13px;font-weight:700;color:#FFFFFF'>" & "Linha Pesada: " & FORMAT ( _ShFatPes, "0%" ) & " do faturamento com " & FORMAT ( _ShUnPes, "0%" ) & " das unidades" & "</div><div style='font-size:11px;color:#A3B1BD;line-height:16px;margin-top:3px'>" & "Cada bateria pesada deixa R$ " & FORMAT ( _LbPes, "#,0" ) & " de lucro bruto, contra R$ " & FORMAT ( _LbLeve, "#,0" ) & " da linha leve." & "</div></div></div>"
			VAR _T2 = "<div class='vx-i' style='display:flex;gap:12px;margin-bottom:10px'><div style='font-size:11px;font-weight:700;color:#FF8C00;min-width:18px;padding-top:2px'>02</div><div><div style='font-size:13px;font-weight:700;color:#FFFFFF'>" & "Refugo em " & FORMAT ( [Scrap Rate], "0.00%" ) & " contra meta de 1,5%" & "</div><div style='font-size:11px;color:#A3B1BD;line-height:16px;margin-top:3px'>" & "Atingir a meta evitaria R$ " & FORMAT ( [Saving Potencial Refugo R$], "#,0" ) & " a custo de fabricação." & "</div></div></div>"
			VAR _T3 = "<div class='vx-i' style='display:flex;gap:12px;margin-bottom:10px'><div style='font-size:11px;font-weight:700;color:#FF8C00;min-width:18px;padding-top:2px'>03</div><div><div style='font-size:13px;font-weight:700;color:#FFFFFF'>" & "MTBF de " & FORMAT ( [MTBF (h)], "#,0" ) & " h: " & FORMAT ( _MtbfGap, "0.0" ) & "× abaixo da meta" & "</div><div style='font-size:11px;color:#A3B1BD;line-height:16px;margin-top:3px'>" & "O MTTR de " & FORMAT ( [MTTR (h)], "0.00" ) & " h está na meta: a equipe conserta rápido, mas as máquinas quebram demais." & "</div></div></div>"
			VAR _T4 = IF ( ISFILTERED ( Dim_Fabrica ), "<div class='vx-i' style='display:flex;gap:12px;margin-bottom:10px'><div style='font-size:11px;font-weight:700;color:#FF8C00;min-width:18px;padding-top:2px'>04</div><div><div style='font-size:13px;font-weight:700;color:#FFFFFF'>" & "Logística reversa sem grão de planta" & "</div><div style='font-size:11px;color:#A3B1BD;line-height:16px;margin-top:3px'>" & "Remova o filtro de planta para ler o EcoCiclo." & "</div></div></div>", "<div class='vx-i' style='display:flex;gap:12px;margin-bottom:10px'><div style='font-size:11px;font-weight:700;color:#FF8C00;min-width:18px;padding-top:2px'>04</div><div><div style='font-size:13px;font-weight:700;color:#FFFFFF'>" & "EcoCiclo em " & FORMAT ( [Taxa Logistica Reversa], "0.0%" ) & " contra meta de 75%" & "</div><div style='font-size:11px;color:#A3B1BD;line-height:16px;margin-top:3px'>" & "Maior vazamento: " & _PiorNome & ", com só " & FORMAT ( _PiorTaxa, "0%" ) & " dos cascos de volta." & "</div></div></div>" )
			RETURN
			    "<div style='font-family:Segoe UI,Arial,sans-serif;padding:2px 4px 0 8px'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap;margin-bottom:10px'>O que os dados dizem</div>" & _T1 & _T2 & _T3 & _T4 & "</div>"
		displayFolder: 91 HTML
		lineageTag: 15cfdccf-b569-5b5e-a76d-bdc2cb691053

	measure 'Catalogo Produtos HTML' =
			VAR _Cards = CONCATENATEX ( Dim_Produto, "<div class='vx-c' style='flex:1;min-width:0;padding:0 14px;border-right:1px solid #3A4651'><div style='height:70px;display:flex;align-items:flex-end;justify-content:center'><img src='" & Dim_Produto[Imagem_Base64] & "' class='vx-img' style='max-height:68px;max-width:100%'/></div><div style='font-size:12px;font-weight:700;color:#FFFFFF;margin-top:8px;white-space:nowrap'>" & Dim_Produto[Nome_Curto] & "</div><div style='font-size:9px;color:#7A8B99;letter-spacing:1.2px;text-transform:uppercase;margin-top:2px'>" & Dim_Produto[Categoria] & "</div><div style='font-size:15px;font-weight:600;color:#FFFFFF;margin-top:4px;white-space:nowrap'>" & IF ( ISBLANK ( [Faturamento Bruto] ), "—", "R$ " & FORMAT ( [Faturamento Bruto], "#,0" ) ) & "</div><div style='font-size:10px;color:#7A8B99;margin-top:3px;white-space:nowrap'>Margem " & FORMAT ( [Margem Bruta %], "0%" ) & " · Refugo " & "<span style='color:" & [Cor Scrap] & "'>" & FORMAT ( [Scrap Rate], "0.0%" ) & "</span></div></div>", "", Dim_Produto[ID_Produto], ASC )
			RETURN
			    "<div style='font-family:Segoe UI,Arial,sans-serif'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap;margin:0 0 6px 14px'>Portfólio · desempenho por SKU</div><div style='display:flex'>" & _Cards & "</div></div>"
		displayFolder: 91 HTML
		lineageTag: 794c67cb-5ed4-591b-988c-b21b5077d8ac

	measure 'Tooltip Produto HTML' =
			VAR _Spark =
			    VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( Dim_Calendario[Mes_Inicio] ), "@v", [Qtd Vendida] ), NOT ISBLANK ( [@v] ) )
			    VAR _mn = MINX ( _t, [@v] )
			    VAR _mx = MAXX ( _t, [@v] )
			    VAR _d0 = MINX ( _t, Dim_Calendario[Mes_Inicio] )
			    VAR _d1 = MAXX ( _t, Dim_Calendario[Mes_Inicio] )
			    VAR _pts = CONCATENATEX ( _t,
			        FORMAT ( DIVIDE ( INT ( Dim_Calendario[Mes_Inicio] - _d0 ), INT ( _d1 - _d0 ) ) * 316 + 2, "0.0", "en-US" ) & "," &
			        FORMAT ( 40 - DIVIDE ( [@v] - _mn, _mx - _mn ) * 36, "0.0", "en-US" ), " ", Dim_Calendario[Mes_Inicio], ASC )
			    VAR _last = MAXX ( TOPN ( 1, _t, Dim_Calendario[Mes_Inicio], DESC ), [@v] )
			    VAR _ly = FORMAT ( 40 - DIVIDE ( _last - _mn, _mx - _mn ) * 36, "0.0", "en-US" )
			    RETURN
			        "<div style='margin-top:6px'><div style='font-size:9px;letter-spacing:1.2px;text-transform:uppercase;color:#7A8B99;margin-bottom:2px'>Vendas mensais (un.)</div><svg width='320' height='40' viewBox='0 0 320 44' preserveAspectRatio='none'><polyline class='vx-spark' points='" & _pts & "' fill='none' stroke='#FF8C00' stroke-width='1.8' stroke-linejoin='round'/><circle class='vx-dot' cx='318' cy='" & _ly & "' r='2.6' fill='#FF8C00'/></svg></div>"
			RETURN
			IF (
			    NOT HASONEVALUE ( Dim_Produto[ID_Produto] ),
			    "<div style='font-family:Segoe UI,Arial,sans-serif;color:#7A8B99;font-size:11px;padding:16px'>Passe o mouse sobre um único produto.</div>",
			    "<div class='vx-tt' style='font-family:Segoe UI,Arial,sans-serif;display:flex;gap:14px;padding:10px 14px 0 14px'><div style='width:104px;display:flex;align-items:center;justify-content:center'><img src='" & [URL Produto] & "' class='vx-img' style='max-width:104px;max-height:96px'/></div><div style='flex:1;min-width:0'><div style='font-size:13px;font-weight:800;color:#FFFFFF;letter-spacing:.4px'>" & UPPER ( SELECTEDVALUE ( Dim_Produto[Nome_Curto] ) ) & "</div><div style='font-size:9px;color:#FF8C00;letter-spacing:1.2px;text-transform:uppercase;margin:2px 0 8px'>" & SELECTEDVALUE ( Dim_Produto[Categoria] ) & "</div>" & "<div style='display:flex;justify-content:space-between;font-size:11px;padding:3px 0;border-bottom:1px solid #3A4651'><span style='color:#7A8B99'>Faturamento</span><span style='color:" & "#FFFFFF" & "';font-weight:600'>" & "R$ " & FORMAT ( [Faturamento Bruto], "#,0" ) & "</span></div>" & "<div style='display:flex;justify-content:space-between;font-size:11px;padding:3px 0;border-bottom:1px solid #3A4651'><span style='color:#7A8B99'>Margem bruta</span><span style='color:" & "#FFFFFF" & "';font-weight:600'>" & FORMAT ( [Margem Bruta %], "0.0%" ) & "</span></div>" & "<div style='display:flex;justify-content:space-between;font-size:11px;padding:3px 0;border-bottom:1px solid #3A4651'><span style='color:#7A8B99'>Refugo</span><span style='color:" & [Cor Scrap] & "';font-weight:600'>" & FORMAT ( [Scrap Rate], "0.00%" ) & "</span></div>" & "<div style='display:flex;justify-content:space-between;font-size:11px;padding:3px 0;border-bottom:1px solid #3A4651'><span style='color:#7A8B99'>Giro</span><span style='color:" & [Cor Giro] & "';font-weight:600'>" & FORMAT ( [Giro Anualizado], "0.0" ) & "×" & "</span></div>" & "<div style='display:flex;justify-content:space-between;font-size:11px;padding:3px 0;border-bottom:1px solid #3A4651'><span style='color:#7A8B99'>Reversa</span><span style='color:" & [Cor Reversa] & "';font-weight:600'>" & IF ( ISBLANK ( [Taxa Logistica Reversa] ), "—", FORMAT ( [Taxa Logistica Reversa], "0%" ) ) & "</span></div>" & "</div></div>" & "<div style='padding:0 14px'>" & _Spark & "</div>"
			)
		displayFolder: 91 HTML
		lineageTag: 108555d0-441d-589e-965f-29530f619302

	measure 'Tooltip Planta HTML' =
			VAR _Spark =
			    VAR _t = FILTER ( ADDCOLUMNS ( VALUES ( Dim_Calendario[Mes_Inicio] ), "@v", [OEE] ), NOT ISBLANK ( [@v] ) )
			    VAR _mn = MINX ( _t, [@v] )
			    VAR _mx = MAXX ( _t, [@v] )
			    VAR _d0 = MINX ( _t, Dim_Calendario[Mes_Inicio] )
			    VAR _d1 = MAXX ( _t, Dim_Calendario[Mes_Inicio] )
			    VAR _pts = CONCATENATEX ( _t,
			        FORMAT ( DIVIDE ( INT ( Dim_Calendario[Mes_Inicio] - _d0 ), INT ( _d1 - _d0 ) ) * 316 + 2, "0.0", "en-US" ) & "," &
			        FORMAT ( 40 - DIVIDE ( [@v] - _mn, _mx - _mn ) * 36, "0.0", "en-US" ), " ", Dim_Calendario[Mes_Inicio], ASC )
			    VAR _last = MAXX ( TOPN ( 1, _t, Dim_Calendario[Mes_Inicio], DESC ), [@v] )
			    VAR _ly = FORMAT ( 40 - DIVIDE ( _last - _mn, _mx - _mn ) * 36, "0.0", "en-US" )
			    RETURN
			        "<div style='margin-top:6px'><div style='font-size:9px;letter-spacing:1.2px;text-transform:uppercase;color:#7A8B99;margin-bottom:2px'>OEE mensal</div><svg width='320' height='40' viewBox='0 0 320 44' preserveAspectRatio='none'><polyline class='vx-spark' points='" & _pts & "' fill='none' stroke='#FF8C00' stroke-width='1.8' stroke-linejoin='round'/><circle class='vx-dot' cx='318' cy='" & _ly & "' r='2.6' fill='#FF8C00'/></svg></div>"
			VAR _Nome = IF ( HASONEVALUE ( Dim_Fabrica[Planta_Curta] ), "PLANTA " & UPPER ( SELECTEDVALUE ( Dim_Fabrica[Planta_Curta] ) ), "TODAS AS PLANTAS" )
			RETURN
			    "<div style='font-family:Segoe UI,Arial,sans-serif;padding:10px 14px'><div style='display:flex;justify-content:space-between;align-items:baseline'><div style='font-size:13px;font-weight:800;color:#FFFFFF;letter-spacing:.4px'>" & _Nome & "</div><div style='font-size:22px;font-weight:600;color:" & [Cor OEE] & "'>" & FORMAT ( [OEE], "0.0%" ) & "<span style='font-size:9px;color:#7A8B99;margin-left:4px'>OEE</span></div></div>" & "<div style='margin-top:7px'><div style='display:flex;justify-content:space-between;font-size:10px'><span style='color:#7A8B99'>Disponibilidade</span><span style='color:#FFFFFF;font-weight:600'>" & FORMAT ( [Disponibilidade], "0.0%" ) & "</span></div><div style='height:4px;background:#3A4651;border-radius:2px;margin-top:3px'><div class='vx-bar' style='height:4px;border-radius:2px;width:" & FORMAT ( [Disponibilidade] * 100, "0.0", "en-US" ) & "%;background:" & "#C9D3DB" & "'></div></div></div>" & "<div style='margin-top:7px'><div style='display:flex;justify-content:space-between;font-size:10px'><span style='color:#7A8B99'>Performance (não medida)</span><span style='color:#FFFFFF;font-weight:600'>" & "n/m" & "</span></div><div style='height:4px;background:#3A4651;border-radius:2px;margin-top:3px'><div class='vx-bar' style='height:4px;border-radius:2px;width:" & FORMAT ( [Performance] * 100, "0.0", "en-US" ) & "%;background:" & "#4E5D6A" & "'></div></div></div>" & "<div style='margin-top:7px'><div style='display:flex;justify-content:space-between;font-size:10px'><span style='color:#7A8B99'>Qualidade</span><span style='color:#FFFFFF;font-weight:600'>" & FORMAT ( [Qualidade], "0.0%" ) & "</span></div><div style='height:4px;background:#3A4651;border-radius:2px;margin-top:3px'><div class='vx-bar' style='height:4px;border-radius:2px;width:" & FORMAT ( [Qualidade] * 100, "0.0", "en-US" ) & "%;background:" & [Cor Scrap] & "'></div></div></div>" & "<div style='display:flex;gap:18px;margin-top:12px;font-size:10px;color:#7A8B99'><div>MTBF <b style='color:" & [Cor MTBF] & "'>" & FORMAT ( [MTBF (h)], "#,0.0" ) & " h</b></div><div>MTTR <b style='color:" & [Cor MTTR] & "'>" & FORMAT ( [MTTR (h)], "0.00" ) & " h</b></div><div>Falhas <b style='color:#FFFFFF'>" & FORMAT ( [Qtd Falhas], "#,0" ) & "</b></div></div>" & _Spark & "</div>"
		displayFolder: 91 HTML
		lineageTag: 0a2d85d6-bb19-56f4-9c02-8658f9541693

	measure 'Capa Energia HTML' = "<svg viewBox='560 110 700 580' width='100%' height='100%' preserveAspectRatio='xMidYMid meet' style='display:block;overflow:visible'><g class='vx-glow'><path class='vx-flow e1' d='M800 372 C 790 352 772 346 762 338'/><path class='vx-base' d='M800 372 C 790 352 772 346 762 338'/><path class='vx-flow e2' d='M885 352 C 885 320 900 300 903 262'/><path class='vx-base' d='M885 352 C 885 320 900 300 903 262'/><path class='vx-flow e3' d='M960 252 C 975 236 995 236 1010 246'/><path class='vx-base' d='M960 252 C 975 236 995 236 1010 246'/><path class='vx-flow e4' d='M1035 282 C 1070 270 1100 262 1118 250'/><path class='vx-base' d='M1035 282 C 1070 270 1100 262 1118 250'/><path class='vx-flow e5' d='M1108 330 C 1140 320 1150 290 1150 262'/><path class='vx-base' d='M1108 330 C 1140 320 1150 290 1150 262'/><path class='vx-flow e6' d='M1128 455 C 1160 440 1170 410 1172 392'/><path class='vx-base' d='M1128 455 C 1160 440 1170 410 1172 392'/><path class='vx-flow f1' d='M650 560 L700 592 L860 592 L902 622 L1060 622'/><path class='vx-base' d='M650 560 L700 592 L860 592 L902 622 L1060 622'/><path class='vx-flow f2' d='M925 548 L985 578 L1100 578 L1150 612 L1250 612'/><path class='vx-base' d='M925 548 L985 578 L1100 578 L1150 612 L1250 612'/><path class='vx-flow f3' d='M690 505 L700 528 L885 566'/><path class='vx-base' d='M690 505 L700 528 L885 566'/><path class='vx-flow f4' d='M1185 560 L1220 540 L1260 540'/><path class='vx-base' d='M1185 560 L1220 540 L1260 540'/><path class='vx-flow f5' d='M640 448 L700 480'/><path class='vx-base' d='M640 448 L700 480'/><path class='vx-flow f6' d='M800 640 L860 660 L1000 660'/><path class='vx-base' d='M800 640 L860 660 L1000 660'/><path class='vx-flow e7' d='M700 330 L740 300 L760 250'/><path class='vx-base' d='M700 330 L740 300 L760 250'/><path class='vx-flow e8' d='M1000 400 C 1040 420 1060 440 1080 470'/><path class='vx-base' d='M1000 400 C 1040 420 1060 440 1080 470'/><path class='vx-flow f7' d='M1060 660 L1140 640 L1200 650'/><path class='vx-base' d='M1060 660 L1140 640 L1200 650'/><circle class='vx-node n0' cx='768' cy='388' r='4'/><circle class='vx-node n1' cx='885' cy='360' r='4'/><circle class='vx-node n2' cx='880' cy='258' r='4'/><circle class='vx-node n3' cx='1035' cy='285' r='4'/><circle class='vx-node n0' cx='1010' cy='435' r='4'/><circle class='vx-node n1' cx='1128' cy='463' r='4'/><circle class='vx-node n2' cx='903' cy='240' r='4'/><circle class='vx-node n3' cx='1150' cy='262' r='4'/><circle class='vx-node n0' cx='1172' cy='392' r='4'/><circle class='vx-node n1' cx='762' cy='338' r='4'/><circle class='vx-spk s0' r='4' style=""offset-path:path('M800 372 C 790 352 772 346 762 338')""/><circle class='vx-spk s1' r='4' style=""offset-path:path('M885 352 C 885 320 900 300 903 262')""/><circle class='vx-spk s2' r='4' style=""offset-path:path('M960 252 C 975 236 995 236 1010 246')""/><circle class='vx-spk s3' r='4' style=""offset-path:path('M1035 282 C 1070 270 1100 262 1118 250')""/><circle class='vx-spk s4' r='4' style=""offset-path:path('M1108 330 C 1140 320 1150 290 1150 262')""/><circle class='vx-spk s5' r='4' style=""offset-path:path('M1128 455 C 1160 440 1170 410 1172 392')""/><circle class='vx-spk s6' r='4' style=""offset-path:path('M650 560 L700 592 L860 592 L902 622 L1060 622')""/><circle class='vx-spk s7' r='4' style=""offset-path:path('M925 548 L985 578 L1100 578 L1150 612 L1250 612')""/><circle class='vx-spk s8' r='4' style=""offset-path:path('M690 505 L700 528 L885 566')""/><circle class='vx-spk s9' r='4' style=""offset-path:path('M1185 560 L1220 540 L1260 540')""/><circle class='vx-spk s10' r='4' style=""offset-path:path('M640 448 L700 480')""/><circle class='vx-spk s11' r='4' style=""offset-path:path('M800 640 L860 660 L1000 660')""/></g></svg>"
		displayFolder: 91 HTML
