	column Coluna
		dataType: string
		isHidden
		lineageTag: 9d44f4cc-e66f-5fa4-8bc5-599fd8462cad
		summarizeBy: none
		sourceColumn: Coluna

		annotation SummarizationSetBy = Automatic

	partition _Medidas = m
		mode: import
		source =
				let
				    Resultado = #table ( type table [Coluna = text], {} )
				in
				    Resultado

	annotation PBI_ResultType = Table

