	measure 'Header Estoque' = "<div style='font-family:Segoe UI,Arial,sans-serif;display:flex;justify-content:space-between;align-items:center;height:44px;padding:0 8px 0 4px'><div class='vx-h' style='display:flex;align-items:baseline;gap:14px'><div class='vx-ht' style='font-size:17px;font-weight:800;letter-spacing:.8px;color:#FFFFFF;font-family:Montserrat,Segoe UI Black,Segoe UI,sans-serif'>ESTOQUE E ECOCICLO</div><div style='font-size:11px;color:#7A8B99'>Giro, cobertura e logística reversa de cascos · " & [Periodo Texto] & "</div></div><div>" & IF ( [Qtd Filtros Ativos] > 0, "<span class='vx-chip' style='color:#FF8C00;border:1px solid #FF8C00;border-radius:999px;padding:3px 10px;font-size:10px;font-weight:700;letter-spacing:1px'>" & [Qtd Filtros Ativos] & IF ( [Qtd Filtros Ativos] = 1, " FILTRO ATIVO", " FILTROS ATIVOS" ) & "</span>", "<span style='color:#7A8B99;border:1px solid #3A4651;border-radius:999px;padding:3px 10px;font-size:10px;font-weight:700;letter-spacing:1px'>VISÃO CONSOLIDADA</span>" ) & "</div></div>"
