0;color:#FFFFFF;margin-top:4px;white-space:nowrap'>" & "R$ " & FORMAT ( [Custo Oportunidade Paradas R$], "#,0" ) & "</div><div style='font-size:10.5px;color:#7A8B99;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "<span class='vx-dot' style='display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:" & "#FF8C00" & "'></span>" & "estimativa a custo" & "</div></div>" & "<div class='vx-k' style='flex:1;min-width:0;padding:4px 14px 0 0;margin-right:14px;'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap'>CPV vendido</div><div class='vx-v' style='font-size:21px;line-height:28px;font-weight:600;color:#FFFFFF;margin-top:4px;white-space:nowrap'>" & "R$ " & FORMAT ( [CPV], "#,0" ) & "</div><div style='font-size:10.5px;color:#7A8B99;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "<span class='vx-dot' style='display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:" & "#7A8B99" & "'></span>" & "Margem " & FORMAT ( [Margem Bruta %], "0.0%" ) & "</div></div>" & "</div>"
		displayFolder: 91 HTML
		lineageTag: e84f84f5-3a2d-547d-baf4-ee3b7cbcba38

	measure 'Header Executivo' = "<div style='font-family:Segoe UI,Arial,sans-serif;display:flex;justify-content:space-between;align-items:center;height:44px;padding:0 8px 0 4px'><div class='vx-h' style='display:flex;align-items:baseline;gap:14px'><div class='vx-ht' style='font-size:17px;font-weight:800;letter-spacing:.8px;color:#FFFFFF;font-family:Montserrat,Segoe UI Black,Segoe UI,sans-serif'>SUMÁRIO EXECUTIVO</div><div style='font-size:11px;color:#7A8B99'>Insights da operação VoltEx · " & [Periodo Texto] & "</div></div><div>" & IF ( [Qtd Filtros Ativos] > 0, "<span class='vx-chip' style='color:#FF8C00;border:1px solid #FF8C00;border-radius:999px;padding:3px 10px;font-size:10px;font-weight:700;letter-spacing:1px'>" & [Qtd Filtros Ativos] & IF ( [Qtd Filtros Ativos] = 1, " FILTRO ATIVO", " FILTROS ATIVOS" ) & "</span>", "<span style='color:#7A8B99;border:1px solid #3A4651;border-radius:999px;padding:3px 10px;font-size:10px;font-weight:700;letter-spacing:1px'>VISÃO CONSOLIDADA</span>" ) & "</div></div>"
		displayFolder: 91 HTML
