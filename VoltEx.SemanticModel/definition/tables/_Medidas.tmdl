table _Medidas
	lineageTag: fafc7a4c-6b9d-577c-95d6-47b33a92439b

	measure 'Qtd Produzida' = SUM ( Fato_Producao[Qtd_Produzida] )
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: a066dcda-ab78-5c25-b8f3-b0674112dc67

	measure 'Horas Programadas' = SUM ( Fato_Producao[Horas_Turno_Programado] )
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: 9c59cdaa-69b8-5203-9cd7-c6cc26ccc271

	measure 'Horas Parada' = SUM ( Fato_Producao[Horas_Parada_Maquina] )
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: 78157409-2382-56b4-8acd-deaaef60112b

	measure 'Horas Operando' = [Horas Programadas] - [Horas Parada]
		formatString: #,0
		displayFolder: 01 Produção
		lineageTag: 0bfa087f-c122-5a01-a5b2-b014911f1856

	measure 'Pecas por Hora' = DIVIDE ( [Qtd Produzida], [Horas Operando] )
		formatString: #,0.0
		displayFolder: 01 Produção
		lineageTag: 6575bc01-44aa-599e-a697-0ca1303e3746

	measure Disponibilidade = DIVIDE ( [Horas Programadas] - [Horas Parada], [Horas Programadas] )
		formatString: 0.0%
		displayFolder: 01 Produção
		lineageTag: 36db2a0e-d326-55ea-aa73-55c1b786cb71

	measure Performance =
			-- Sem capacidade teórica (peças/hora) por linha na base: fator fixado em 100%.
			-- Substituir por DIVIDE ( [Qtd Produzida], [Capacidade Teorica] ) quando o dado existir.
			IF ( NOT ISBLANK ( [Qtd Produzida] ), 1 )
		formatString: 0.0%
		displayFolder: 01 Produção
		lineageTag: ee20aa68-f9fa-5754-884a-dc6032579840

	measure Qualidade = DIVIDE ( [Qtd Produzida] - [Qtd Refugo], [Qtd Produzida] )
		formatString: 0.0%
		displayFolder: 01 Produção
		lineageTag: bca0cad7-f16c-5647-a862-4be9eff39e09

	measure OEE = [Disponibilidade] * [Performance] * [Qualidade]
		formatString: 0.0%
		displayFolder: 01 Produção
		lineageTag: a8081211-b523-5c9f-9670-13d38b0b9881

	measure 'Qtd Falhas' = SUM ( Fato_Producao[Qtd_Falhas_Equipamento] )
		formatString: #,0
		displayFolder: 02 Manutenção
		lineageTag: 993ac942-b854-51f4-aaa6-2f5688fb2771

	measure 'MTBF (h)' = DIVIDE ( [Horas Programadas] - [Horas Parada], [Qtd Falhas] )
		formatString: #,0.0
		displayFolder: 02 Manutenção
		lineageTag: 8aa5d0e0-1efc-5336-b968-b49cb7e65f6e

	measure 'MTTR (h)' = DIVIDE ( [Horas Parada], [Qtd Falhas] )
		formatString: #,0.00
		displayFolder: 02 Manutenção
		lineageTag: a884df9a-57a2-5270-9e9f-a60c0def7dc2

	measure 'Qtd Refugo' = SUM ( Fato_Producao[Qtd_Refugo] )
		formatString: #,0
		displayFolder: 03 Qualidade
		lineageTag: cf5b2aaa-49ca-5bcc-aae9-224b8603693d

	measure 'Scrap Rate' = DIVIDE ( [Qtd Refugo], [Qtd Produzida] )
		formatString: 0.00%
		displayFolder: 03 Qualidade
		lineageTag: fa5f2233-1efa-5b35-a11e-4138af719b11

	measure 'Custo do Refugo R$' =
			SUMX (
			    Fato_Producao,
			    Fato_Producao[Qtd_Refugo] * RELATED ( Dim_Produto[Custo_Fabricacao] )
			)
		formatString: R$ #,0
		displayFolder: 03 Qualidade
		lineageTag: da555085-61e9-5166-8b6f-a08f7adba929

	measure 'Saving Potencial Refugo R$' =
			-- Custo evitado se o refugo estivesse na meta de 1,5%
			VAR _Meta = [Meta Scrap]
			VAR _Atual = [Scrap Rate]
			RETURN
			    IF ( _Atual > _Meta, [Custo do Refugo R$] * ( 1 - DIVIDE ( _Meta, _Atual ) ), 0 )
		formatString: R$ #,0
		displayFolder: 03 Qualidade
		lineageTag: 1e5f2a90-a759-58b2-bf65-1cc7eb1aa122

	measure 'Qtd Vendida' = SUM ( Fato_Vendas[Quantidade] )
		formatString: #,0
		displayFolder: 04 Vendas
		lineageTag: fc5e8561-c5e7-577e-bb12-8120431b8be2

	measure 'Faturamento Bruto' = SUMX ( Fato_Vendas, Fato_Vendas[Quantidade] * RELATED ( Dim_Produto[Preco_Venda] ) )
		formatString: R$ #,0
		displayFolder: 04 Vendas
		lineageTag: c669e1dc-c53f-5b4f-ac50-bc7e64ebfa0b

	measure CPV = SUMX ( Fato_Vendas, Fato_Vendas[Quantidade] * RELATED ( Dim_Produto[Custo_Fabricacao] ) )
		formatString: R$ #,0
		displayFolder: 04 Vendas
		lineageTag: 09325f1e-754d-526c-a80b-268d5e2bb846

	measure 'Margem Bruta R$' = [Faturamento Bruto] - [CPV]
		formatString: R$ #,0
		displayFolder: 04 Vendas
		lineageTag: 5dec1f49-d7f0-5a79-92bd-9f12f7974e50

	measure 'Margem Bruta %' = DIVIDE ( [Margem Bruta R$], [Faturamento Bruto] )
		formatString: 0.0%
		displayFolder: 04 Vendas
		lineageTag: f021ebad-cf1d-53ef-bf88-986cbabe91c7

	measure 'Lucro Bruto por Unidade' = DIVIDE ( [Margem Bruta R$], [Qtd Vendida] )
		formatString: R$ #,0.00
		displayFolder: 04 Vendas
		lineageTag: 7fbfa859-33f7-5faf-9f54-9c84630db18a

	measure 'Share Faturamento' = DIVIDE ( [Faturamento Bruto], CALCULATE ( [Faturamento Bruto], REMOVEFILTERS ( Dim_Produto ) ) )
		formatString: 0.0%
		displayFolder: 04 Vendas
		lineageTag: 99092729-c334-51a5-9a0f-f13766800b95

	measure 'Share Unidades' = DIVIDE ( [Qtd Vendida], CALCULATE ( [Qtd Vendida], REMOVEFILTERS ( Dim_Produto ) ) )
		formatString: 0.0%
		displayFolder: 04 Vendas
		lineageTag: fd95c40a-ec31-5422-806b-67a1196cb9d2

	measure 'Estoque Final' =
			-- Estoque é snapshot (semi-aditivo): pega a última foto do período, soma só entre produtos/plantas
			VAR _UltimaFoto =
			    CALCULATE ( MAX ( Fato_Estoque_Mensal[Data_Referencia] ) )
			RETURN
			    CALCULATE (
			        SUM ( Fato_Estoque_Mensal[Qtd_Estoque_Pecas] ),
			        Dim_Calendario[Data] = _UltimaFoto
			    )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: a4977728-80d8-554b-8a7c-a9dffc0652e1

	measure 'Estoque Medio' = AVERAGEX ( VALUES ( Dim_Calendario[AnoMes] ), [Estoque Final] )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: be015b85-6263-5915-bb78-168f3b4d0319

	measure 'Meses com Foto' = CALCULATE ( DISTINCTCOUNT ( Fato_Estoque_Mensal[Data_Referencia] ) )
		formatString: #,0
		displayFolder: 05 Estoque
		lineageTag: 831db87d-c9da-5fae-b123-562e0c550de9

	measure 'Giro Anualizado' =
			-- Vendas ÷ estoque médio, normalizado para 12 meses (filtrar um trimestre não derruba o giro)
			DIVIDE ( [Qtd Vendida], [Estoque Medio] ) * DIVIDE ( 12, [Meses com Foto] )
		formatString: 0.0x
		displayFolder: 05 Estoque
		lineageTag: 52f2a1e6-4239-5ead-b1a7-4716d3b479cb

	measure 'Cascos Recolhidos' = SUM ( Fato_Coleta_Cascos[Qtd_Cascos_Recolhidos] )
		formatString: #,0
		displayFolder: 06 EcoCiclo
		lineageTag: 662012a3-96b0-55fe-b2dd-57a69c9e919a

	measure 'Taxa Logistica Reversa' =
			-- Fato_Coleta_Cascos não tem grão de planta: com filtro de planta o numerador
			-- ficaria inteiro e o denominador parcial. A medida se recusa a responder.
			IF (
			    ISFILTERED ( Dim_Fabrica ),
			    BLANK (),
			    DIVIDE ( [Cascos Recolhidos], [Qtd Vendida] )
			)
		formatString: 0.0%
		displayFolder: 06 EcoCiclo
		lineageTag: 8cca7d3b-5dd0-5561-9f37-b5c34e770c2c

	measure 'Gap Cascos p/ Meta' =
			IF (
			    NOT ISFILTERED ( Dim_Fabrica ),
			    MAX ( 0, [Meta Reversa] * [Qtd Vendida] - [Cascos Recolhidos] )
			)
		formatString: #,0
		displayFolder: 06 EcoCiclo
		lineageTag: 966336b3-9fbc-517a-be32-3cc6ad5dab6d

	measure 'Producao Perdida (un)' =
			-- Peças que deixaram de ser feitas: horas paradas × ritmo real do próprio turno
			SUMX (
			    Fato_Producao,
			    VAR _HorasOp = Fato_Producao[Horas_Turno_Programado] - Fato_Producao[Horas_Parada_Maquina]
			    RETURN
			        Fato_Producao[Horas_Parada_Maquina] * DIVIDE ( Fato_Producao[Qtd_Produzida], _HorasOp )
			)
		formatString: #,0
		displayFolder: 07 Custos
		lineageTag: 36e81f1f-a1ef-548e-b4cc-ed28d90eee13

	measure 'Custo Oportunidade Paradas R$' =
			-- Estimativa a custo de fabricação (não a preço de venda) da produção perdida em paradas
			SUMX (
			    Fato_Producao,
			    VAR _HorasOp = Fato_Producao[Horas_Turno_Programado] - Fato_Producao[Horas_Parada_Maquina]
			    RETURN
			        Fato_Producao[Horas_Parada_Maquina]
			            * DIVIDE ( Fato_Producao[Qtd_Produzida], _HorasOp )
			            * RELATED ( Dim_Produto[Custo_Fabricacao] )
			)
		formatString: R$ #,0
		displayFolder: 07 Custos
		lineageTag: f7c459d8-cb15-5d99-9a94-b6a1c8af2707

	measure 'Impacto Operacional R$' = [Custo do Refugo R$] + [Custo Oportunidade Paradas R$]
		formatString: R$ #,0
		displayFolder: 07 Custos
		lineageTag: 0d07acf5-1878-50b8-b721-a869735d6f17

	measure 'Impacto % do CPV Produzido' =
			DIVIDE (
			    [Impacto Operacional R$],
			    SUMX ( Fato_Producao, Fato_Producao[Qtd_Produzida] * RELATED ( Dim_Produto[Custo_Fabricacao] ) )
			)
		formatString: 0.0%
		displayFolder: 07 Custos
		lineageTag: 7d0b9585-0748-52ed-a7b6-96294bb103b4

	measure 'Meta OEE' = 0.85
		formatString: 0.0%
		displayFolder: 08 Metas
		lineageTag: 587f9768-e53f-5d3b-abcc-d7934a7d8ff7

	measure 'Meta Scrap' = 0.015
		formatString: 0.0%
		displayFolder: 08 Metas
		lineageTag: 383beca9-bf5a-58e3-be3c-8f0a57bd55ea

	measure 'Meta MTBF' = 300
		formatString: #,0
		displayFolder: 08 Metas
		lineageTag: ac05275c-43d5-5ff5-a658-17cb457783d7

	measure 'Meta MTTR' = 2.5
		formatString: 0.0
		displayFolder: 08 Metas
		lineageTag: d482cd65-61a9-5c70-a777-ef77c6655c47

	measure 'Meta Giro' = 6
		formatString: 0.0
		displayFolder: 08 Metas
		lineageTag: 8ad08fa3-4d43-5b10-8381-4a0099b88c7a

	measure 'Meta Reversa' = 0.75
		formatString: 0.0%
		displayFolder: 08 Metas
		lineageTag: c4e8fe60-0f4f-5aeb-a776-62facf01b2e8

	measure 'Cor OEE' = SWITCH ( TRUE (), ISBLANK ( [OEE] ), "#7A8B99", [OEE] >= 0.85, "#2FBF71", [OEE] >= 0.70, "#FF8C00", "#E5484D" )
		displayFolder: 90 UX
		lineageTag: 6a7e2419-ae45-5258-8b94-6adea2ec799e

	measure 'Cor Scrap' = SWITCH ( TRUE (), ISBLANK ( [Scrap Rate] ), "#7A8B99", [Scrap Rate] < 0.015, "#2FBF71", [Scrap Rate] <= 0.03, "#FF8C00", "#E5484D" )
		displayFolder: 90 UX
		lineageTag: 2d95b8b7-e2a7-50c7-8163-40bd34c0aad1

	measure 'Cor MTBF' = SWITCH ( TRUE (), ISBLANK ( [MTBF (h)] ), "#7A8B99", [MTBF (h)] > 300, "#2FBF71", [MTBF (h)] > 150, "#FF8C00", "#E5484D" )
		displayFolder: 90 UX
		lineageTag: 1342b0e1-84bb-5413-9364-2c9e9892be82

	measure 'Cor MTTR' = SWITCH ( TRUE (), ISBLANK ( [MTTR (h)] ), "#7A8B99", [MTTR (h)] < 2.5, "#2FBF71", "#E5484D" )
		displayFolder: 90 UX
		lineageTag: 805ce132-5a87-5e52-8e39-31d9cfd7392f

	measure 'Cor Giro' = SWITCH ( TRUE (), ISBLANK ( [Giro Anualizado] ), "#7A8B99", [Giro Anualizado] > 6, "#2FBF71", "#FF8C00" )
		displayFolder: 90 UX
		lineageTag: 036097d3-c0d6-5e5c-b1c9-290ed0ae427e

	measure 'Cor Reversa' = SWITCH ( TRUE (), ISBLANK ( [Taxa Logistica Reversa] ), "#7A8B99", [Taxa Logistica Reversa] > 0.75, "#2FBF71", [Taxa Logistica Reversa] >= 0.50, "#FF8C00", "#E5484D" )
		displayFolder: 90 UX
		lineageTag: dd9b70f6-be40-5024-ac7e-faca19f0ed3f

	measure 'Periodo Texto' = FORMAT ( MIN ( Dim_Calendario[Data] ), "mmm/yy" ) & " – " & FORMAT ( MAX ( Dim_Calendario[Data] ), "mmm/yy" )
		displayFolder: 90 UX
		lineageTag: dd96238b-7d8f-541e-a58d-b744c0aca4ea

	measure 'Qtd Filtros Ativos' =
			INT ( ISFILTERED ( Dim_Calendario ) )
			    + INT ( ISFILTERED ( Dim_Fabrica ) )
			    + INT ( ISFILTERED ( Dim_Produto ) )
			    + INT ( ISFILTERED ( Dim_Cliente ) )
		formatString: 0
		displayFolder: 90 UX
		lineageTag: 210a591c-4a3e-51d2-8a4d-636676c439cb

	measure 'URL Produto' = SELECTEDVALUE ( Dim_Produto[Imagem_Base64] )
		displayFolder: 90 UX
		lineageTag: 3f65297c-ec5f-5499-9a58-8206b056ab3b

	measure 'KPI Executivo HTML' = "<div style='display:flex;font-family:Segoe UI,Arial,sans-serif;padding-top:2px'>" & "<div class='vx-k' style='flex:1;min-width:0;padding:4px 14px 0 0;margin-right:14px;border-right:1px solid #3A4651;'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap'>Faturamento bruto</div><div class='vx-v' style='font-size:21px;line-height:28px;font-weight:600;color:#FFFFFF;margin-top:4px;white-space:nowrap'>" & "R$ " & FORMAT ( [Faturamento Bruto], "#,0" ) & "</div><div style='font-size:10.5px;color:#7A8B99;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "<span class='vx-dot' style='display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:" & "#FF8C00" & "'></span>" & FORMAT ( [Qtd Vendida], "#,0" ) & " baterias" & "</div></div>" & "<div class='vx-k' style='flex:1;min-width:0;padding:4px 14px 0 0;margin-right:14px;border-right:1px solid #3A4651;'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap'>Margem bruta</div><div class='vx-v' style='font-size:21px;line-height:28px;font-weight:600;color:#FFFFFF;margin-top:4px;white-space:nowrap'>" & IF ( ISBLANK ( [Margem Bruta %] ), "—", FORMAT ( [Margem Bruta %], "0.0%" ) ) & "</div><div style='font-size:10.5px;color:#7A8B99;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "<span class='vx-dot' style='display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:" & "#7A8B99" & "'></span>" & "R$ " & FORMAT ( [Margem Bruta R$], "#,0" ) & "</div></div>" & "<div class='vx-k' style='flex:1;min-width:0;padding:4px 14px 0 0;margin-right:14px;border-right:1px solid #3A4651;'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap'>OEE</div><div class='vx-v' style='font-size:21px;line-height:28px;font-weight:600;color:#FFFFFF;margin-top:4px;white-space:nowrap'>" & IF ( ISBLANK ( [OEE] ), "—", FORMAT ( [OEE], "0.0%" ) ) & "</div><div style='font-size:10.5px;color:#7A8B99;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "<span class='vx-dot' style='display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:" & [Cor OEE] & "'></span>" & "Meta > 85% · D × Q" & "</div></div>" & "<div class='vx-k' style='flex:1;min-width:0;padding:4px 14px 0 0;margin-right:14px;border-right:1px solid #3A4651;'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap'>Índice de refugo</div><div class='vx-v' style='font-size:21px;line-height:28px;font-weight:600;color:#FFFFFF;margin-top:4px;white-space:nowrap'>" & IF ( ISBLANK ( [Scrap Rate] ), "—", FORMAT ( [Scrap Rate], "0.00%" ) ) & "</div><div style='font-size:10.5px;color:#7A8B99;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "<span class='vx-dot' style='display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:" & [Cor Scrap] & "'></span>" & "Meta < 1,5%" & "</div></div>" & "<div class='vx-k' style='flex:1;min-width:0;padding:4px 14px 0 0;margin-right:14px;border-right:1px solid #3A4651;'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap'>MTBF</div><div class='vx-v' style='font-size:21px;line-height:28px;font-weight:600;color:#FFFFFF;margin-top:4px;white-space:nowrap'>" & IF ( ISBLANK ( [MTBF (h)] ), "—", FORMAT ( [MTBF (h)], "#,0.0" ) ) & " h" & "</div><div style='font-size:10.5px;color:#7A8B99;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "<span class='vx-dot' style='display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:" & [Cor MTBF] & "'></span>" & "Meta > 300 h" & "</div></div>" & "<div class='vx-k' style='flex:1;min-width:0;padding:4px 14px 0 0;margin-right:14px;'><div style='font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:#7A8B99;font-weight:600;white-space:nowrap'>Logística reversa</div><div class='vx-v' style='font-size:21px;line-height:28px;font-weight:600;color:#FFFFFF;margin-top:4px;white-space:nowrap'>" & IF ( ISBLANK ( [Taxa Logistica Reversa] ), "—", FORMAT ( [Taxa Logistica Reversa], "0.0%" ) ) & "</div><div style='font-size:10.5px;color:#7A8B99;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis'>" & "<span class='vx-dot' style='display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;background:" & [Cor Reversa] & "'></span>" & IF ( ISFILTERED ( Dim_Fabrica ), "Sem grão de planta", "Meta > 75%" ) & "</div></div>" & "</div>"
		displayFolder: 91 HTML
