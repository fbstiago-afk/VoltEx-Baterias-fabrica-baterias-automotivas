table Dim_Fabrica
	lineageTag: 792b333e-f292-5391-b4e0-141f90fce998

	column ID_Fabrica
		dataType: int64
		isHidden
		lineageTag: 604819a8-a11c-5517-ad68-2ca6d58f8432
		summarizeBy: none
		sourceColumn: ID_Fabrica

		annotation SummarizationSetBy = Automatic

	column Nome_Fabrica
		dataType: string
		lineageTag: e3465768-6b20-5cd8-9ee4-ac86aeab3eb5
		summarizeBy: none
		sourceColumn: Nome_Fabrica

		annotation SummarizationSetBy = Automatic

	column Planta_Curta
		dataType: string
		lineageTag: 60f28cdf-71c4-5636-9d0f-4529b66e0669
		summarizeBy: none
		sourceColumn: Planta_Curta
		sortByColumn: ID_Fabrica

		annotation SummarizationSetBy = Automatic

	column Estado
		dataType: string
		lineageTag: c8d5a936-5fd4-5fb7-b2d7-4703524cfde6
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: Estado

		annotation SummarizationSetBy = Automatic

	partition Dim_Fabrica = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook ( File.Contents ( CaminhoBase ), null, true ),
				    Planilha = Fonte{[Item = "Dim_Fabrica", Kind = "Sheet"]}[Data],
				    Cabecalho = Table.PromoteHeaders ( Planilha, [PromoteAllScalars = true] ),
				    Tipos = Table.TransformColumnTypes ( Cabecalho, {
				        {"ID_Fabrica", Int64.Type},
				        {"Nome_Fabrica", type text},
				        {"Estado", type text}
				    } ),
				    Resultado = Table.AddColumn ( Tipos, "Planta_Curta", each
				        if Text.Contains ( [Nome_Fabrica], "Campinas" ) then "Campinas"
				        else if Text.Contains ( [Nome_Fabrica], "Joinville" ) then "Joinville"
				        else if Text.Contains ( [Nome_Fabrica], "Manaus" ) then "Manaus"
				        else [Nome_Fabrica], type text )
				in
				    Resultado

	annotation PBI_ResultType = Table

