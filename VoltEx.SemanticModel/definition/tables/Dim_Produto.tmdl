		lineageTag: 033e2bb3-b0f9-5ba3-80e5-1ebc1043f5f5
		summarizeBy: none
		sourceColumn: Nome_Produto

		annotation SummarizationSetBy = Automatic

	column Nome_Curto
		dataType: string
		lineageTag: 4488e2a0-7c60-552b-aba3-507b9a3eb839
		summarizeBy: none
		sourceColumn: Nome_Curto
		sortByColumn: ID_Produto

		annotation SummarizationSetBy = Automatic

	column Categoria
		dataType: string
		lineageTag: cd488f80-1ba9-5cc1-ae42-58f230ba0377
		summarizeBy: none
		sourceColumn: Categoria
		sortByColumn: Ordem_Linha

		annotation SummarizationSetBy = Automatic

	column Ordem_Linha
