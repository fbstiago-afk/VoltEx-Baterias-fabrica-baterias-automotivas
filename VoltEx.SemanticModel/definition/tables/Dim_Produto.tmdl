	column URL_Imagem
		dataType: string
		isHidden
		lineageTag: abca1d21-70ec-5d2f-a37f-0e1e9e0aea9b
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: URL_Imagem

		annotation SummarizationSetBy = Automatic

	column Imagem_Base64
		dataType: string
		lineageTag: bfac511c-173b-59fb-ac03-4e2ce5883260
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: Imagem_Base64

		annotation SummarizationSetBy = Automatic

	partition Dim_Produto = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook ( File.Contents ( CaminhoBase ), null, true ),
				    Planilha = Fonte{[Item = "Dim_Produto", Kind = "Sheet"]}[Data],
				    Cabecalho = Table.PromoteHeaders ( Planilha, [PromoteAllScalars = true] ),
				    Tipos = Table.TransformColumnTypes ( Cabecalho, {
				        {"ID_Produto", Int64.Type},
				        {"Nome_Produto", type text},
				        {"Categoria", type text},
				        {"Custo_Fabricacao", type number},
				        {"Preco_Venda", type number},
				        {"URL_Imagem", type text}
				    } ),
				    NomeCurto = Table.AddColumn ( Tipos, "Nome_Curto", each
				        { "Moto 7Ah", "Moto 9Ah AGM", "Carro 60Ah", "Carro 72Ah SS", "Caminhão 150Ah", "Trator/Ônibus 220Ah" }{[ID_Produto] - 1}, type text ),
				    OrdemLinha = Table.AddColumn ( NomeCurto, "Ordem_Linha", each
				        if [Categoria] = "Linha Pesada" then 1 else if [Categoria] = "Linha Leve" then 2 else 3, Int64.Type ),
				    // Fotos reais dos produtos embutidas (WebP base64, < 26 mil caracteres cada) — dispensa hospedagem
				    Imagens = #table ( type table [ID_Produto = Int64.Type, Imagem_Base64 = text], {
				        { 1, "data:image/webp;base64," },
				        { 2, "data:image/webp;base64," },
				        { 3, "data:image/webp;base64," },
				        { 4, "data:image/webp;base64," },
				        { 5, "data:image/webp;base64," },
				        { 6, "data:image/webp;base64," }
				    } ),
				    Junta = Table.NestedJoin ( OrdemLinha, {"ID_Produto"}, Imagens, {"ID_Produto"}, "Img", JoinKind.LeftOuter ),
				    Resultado = Table.ExpandTableColumn ( Junta, "Img", {"Imagem_Base64"} )
				in
				    Resultado

	annotation PBI_ResultType = Table

