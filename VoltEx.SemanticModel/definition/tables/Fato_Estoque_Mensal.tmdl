table Fato_Estoque_Mensal
	lineageTag: c8eab20a-21a5-5409-b52a-8541724f61ec

	column Data_Referencia
		dataType: dateTime
		isHidden
		formatString: dd/mm/yyyy
		lineageTag: be62de74-507a-519e-b8a1-5ccabc0c1d26
		summarizeBy: none
		sourceColumn: Data_Referencia

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column ID_Produto
		dataType: int64
		isHidden
		lineageTag: e8a660b9-df12-5c66-81cf-5c1f6b6d7417
		summarizeBy: none
		sourceColumn: ID_Produto

		annotation SummarizationSetBy = Automatic

	column ID_Fabrica
		dataType: int64
		isHidden
		lineageTag: 3613e56c-83e1-5879-9110-cf9f2cfe0e19
		summarizeBy: none
		sourceColumn: ID_Fabrica

		annotation SummarizationSetBy = Automatic

	column Qtd_Estoque_Pecas
		dataType: int64
		isHidden
		lineageTag: 308ef319-34ed-5be9-bb87-6546f9595f26
		summarizeBy: none
		sourceColumn: Qtd_Estoque_Pecas

		annotation SummarizationSetBy = Automatic

	partition Fato_Estoque_Mensal = m
		mode: import
		source =
				let
				    Fonte = Excel.Workbook ( File.Contents ( CaminhoBase ), null, true ),
				    Planilha = Fonte{[Item = "Fato_Estoque_Mensal", Kind = "Sheet"]}[Data],
				    Cabecalho = Table.PromoteHeaders ( Planilha, [PromoteAllScalars = true] ),
				    Tipos = Table.TransformColumnTypes ( Cabecalho, {
				        {"Data_Referencia", type date},
				        {"ID_Produto", Int64.Type},
				        {"ID_Fabrica", Int64.Type},
				        {"Qtd_Estoque_Pecas", Int64.Type}
				    } ),
				    Resultado = Tipos
				in
				    Resultado

	annotation PBI_ResultType = Table

